package com.videograb

import android.content.Context
import kotlinx.coroutines.flow.MutableStateFlow
import org.json.JSONArray
import org.json.JSONObject

data class HistoryItem(
    val title: String,
    val uri: String,
    val audio: Boolean,
    val size: Long,
    val time: Long
)

object History {
    val version = MutableStateFlow(0)
    private const val PREFS = "vg"
    private const val KEY = "history"

    @Synchronized
    fun all(ctx: Context): List<HistoryItem> {
        val s = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY, null)
            ?: return emptyList()
        return try {
            val a = JSONArray(s)
            (0 until a.length()).map { i ->
                val o = a.getJSONObject(i)
                HistoryItem(
                    o.getString("t"), o.getString("u"), o.getBoolean("a"),
                    o.getLong("s"), o.getLong("d")
                )
            }
        } catch (e: Exception) {
            emptyList()
        }
    }

    @Synchronized
    private fun write(ctx: Context, list: List<HistoryItem>) {
        val a = JSONArray()
        for (it in list.take(200)) {
            a.put(
                JSONObject()
                    .put("t", it.title).put("u", it.uri).put("a", it.audio)
                    .put("s", it.size).put("d", it.time)
            )
        }
        ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
            .edit().putString(KEY, a.toString()).apply()
    }

    @Synchronized
    fun add(ctx: Context, item: HistoryItem) {
        write(ctx, listOf(item) + all(ctx))
        version.value = version.value + 1
    }

    @Synchronized
    fun remove(ctx: Context, uri: String) {
        write(ctx, all(ctx).filter { it.uri != uri })
        version.value = version.value + 1
    }

    @Synchronized
    fun replaceQuietly(ctx: Context, list: List<HistoryItem>) {
        write(ctx, list)
    }
}
